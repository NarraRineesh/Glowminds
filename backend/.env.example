# ── HTTP API ────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Firebase admin (service account) ────────────────────────────────────
# Point GOOGLE_APPLICATION_CREDENTIALS at a service account JSON file.
# Generate one at: Firebase Console -> Project Settings -> Service accounts
# -> "Generate new private key". Drop the file at backend/service-account.json
# (it's gitignored). DO NOT use the Web SDK apiKey here - that's a different
# credential meant for the frontend.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
FIREBASE_PROJECT_ID=glowminds-abc84

# ── AI providers ────────────────────────────────────────────────────────
# Primary: Google Generative Language API (Gemini) — used for chat, grammar,
# paraphrase, parse-resume, interview question generation + batch session
# evaluation, profile review, and job match scoring.
# Header: X-goog-api-key.
GEMINI_API_KEY=

# Fallback (always tried after Gemini) + primary for cover-letter creativity.
# Get a free key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=https://ai-jobcopilot.web.app
OPENROUTER_APP_NAME=Glowminds AI Job Copilot

# ── Razorpay (payments) ─────────────────────────────────────────────────
# Get these from Razorpay Dashboard → Settings → API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Manual sync (npm run sync) ──────────────────────────────────────────
# Sync NEVER runs automatically — only when you invoke `npm run sync`.
ENRICH_URL=http://127.0.0.1:5000
SYNC_CONCURRENCY=5
SYNC_DRY_RUN=false
