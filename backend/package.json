  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext js,json --exec 'node --env-file=.env src/server.js'",
    "start": "node --env-file=.env src/server.js",
