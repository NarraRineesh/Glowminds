%% Glowminds — ATS Ingestion Pipeline (current)
%% Covers the deep flow of how a job goes from an ATS provider into
%% Firestore. For the wider system view (frontend, all backend APIs,
%% AI services, payments, data model), see system-architecture.mmd.
%% Render with:
%%   npx -y -p @mermaid-js/mermaid-cli mmdc -i ats-ingestion.mmd \
%%     -o ats-ingestion.png -w 2800 -H 3400 -b transparent
flowchart TB
    %% ====================================================================
    %% TRIGGERS — sync starts from the scheduler.
    %% ====================================================================
    subgraph triggers ["⏱️ Sync triggers"]
        direction LR
        CRON["⏰ <b>node-cron</b><br/>(in-process scheduler)<br/>Greenhouse 2h · Lever 2h<br/>Ashby 4h · Bamboo 6h"]
    end

    %% ====================================================================
    %% HETZNER VPS — Node + Python on a single host.
    %% ====================================================================
    subgraph hetzner ["🖥️ Hetzner VPS (single host)"]
        direction TB

        subgraph runner ["🟢 Node.js Sync Runner"]
            direction TB
            RS["🚀 <b>runProvider / runAllProviders</b><br/>per-platform concurrency<br/>writes sync_runs/{id} progress"]
            FETCH["🪶 <b>Lightweight ATS Listing</b><br/>id · title · location<br/>updatedAt · applyUrl"]
            SNAP["🧮 <b>Snapshot company counters</b><br/>newJobCount · newIndiaCount<br/>newLatestUpdatedAt"]
            W0[/"📝 lastSyncAt = now"/]
            G1{"🚦 <b>Company Gate</b><br/>jobCount · indiaJobCount · latestUpdatedAt<br/>all unchanged?"}
            IND["🇮🇳 <b>India Filter</b><br/>India · Remote India<br/>BLR · HYD · PUN · CHN<br/>GGN · MUM · DEL"]
            G2{"🧬 <b>Job Gate</b><br/>fp = hash(title + location + updatedAt)<br/>matches stored?"}
            DET["📄 <b>Detail Fetch</b><br/>only new / changed India jobs"]
            ENRICH["🔌 <b>POST localhost:5000/enrich</b><br/>rawHtml + plainText"]
            MERGE["🧩 <b>Merge enriched JSON</b>"]
            SAVE["💾 <b>Save FINAL job doc</b><br/>source = ats:&lt;ats&gt;<br/>status = ACTIVE · indexedAt = now"]
            W1[/"📝 jobCount · indiaJobCount<br/>latestUpdatedAt · syncFailures = 0"/]
        end

        subgraph py ["🐍 Python Enrich Service (Flask · localhost:5000)"]
            direction TB
            CLEAN["🧹 <b>HTML Cleaning</b><br/>BeautifulSoup · lxml"]
            EXTRACT["🤖 <b>Regex / NLP Extract</b><br/>skills · experience · seniority<br/>role · remote · employmentType<br/>derive searchText"]
            RESP["📤 <b>Return enriched JSON</b>"]
        end

        subgraph bg ["🛠️ Background workers (node-cron · same process)"]
            direction LR
            BW1["⏳ <b>Expiration · daily 02:00</b><br/>lastSeenAt &lt; now-14d<br/>→ status = EXPIRED"]
            BW2["🔁 <b>Retry Queue · every 15m</b><br/>reprocess failed_jobs entries"]
            BW3["🩺 <b>Health Monitor · every 1h</b><br/>syncFailures &gt; N<br/>→ active = false"]
        end
    end

    %% Branch outcomes
    SKIP1["⛔ Skip company"]
    DROP["🗑️ Drop non-India"]
    SKIP2["⏭️ Skip job"]
    DETFAIL["❌ retry_queue/{id}"]
    FALL["⚠️ Partial fallback<br/>(skip enrichment, save plain text)"]

    %% ====================================================================
    %% FIRESTORE
    %% ====================================================================
    subgraph fs ["🔥 Firestore"]
        direction TB
        FS_COMP[("companies/{slug}<br/>━━━━━━━<br/>name · ats · slug · active<br/>jobsApi · careersUrl<br/>jobCount · indiaJobCount<br/>lastSyncAt · syncFailures · lastError")]
        FS_JOBS[("jobs/{jobId}<br/>━━━━━━━<br/>source · title · company<br/>location · skills · experience<br/>searchText · applyUrl<br/>status · indexedAt · lastSeenAt")]
        FS_RUNS[("sync_runs/{id}<br/>━━━━━━━<br/>provider · startedAt · finishedAt<br/>companiesScanned · companiesSkipped<br/>jobsAdded · jobsUpdated · jobsExpired<br/>errors[]")]
        FS_RT[("retry_queue/{id}<br/>stage · payload · attempts<br/>nextAttemptAt")]
    end

    %% ====================================================================
    %% TRIGGER FLOWS
    %% ====================================================================
    CRON --> RS

    %% ====================================================================
    %% INGESTION FLOW (per company)
    %% ====================================================================
    RS --> FETCH --> SNAP --> W0 --> G1
    G1 -- "all same" --> SKIP1
    G1 -- "any changed" --> IND
    IND -- "non-india" --> DROP
    IND -- "india" --> G2
    G2 -- "match" --> SKIP2
    G2 -- "new / changed" --> DET
    DET -- "fail" --> DETFAIL
    DET --> ENRICH
    ENRICH --> CLEAN --> EXTRACT --> RESP
    RESP -- "fail / timeout" --> FALL
    RESP --> MERGE
    FALL --> MERGE
    MERGE --> SAVE --> W1

    %% Firestore writes
    SAVE --> FS_JOBS
    W1 -.-> FS_COMP
    W0 -.-> FS_COMP
    DETFAIL -.-> FS_RT
    RS -.->|"per-batch progress"| FS_RUNS

    %% Background workers
    BW1 -.-> FS_JOBS
    BW2 -.-> FS_RT
    BW2 -.-> DET
    BW3 -.-> FS_COMP

    %% ====================================================================
    %% STYLES
    %% ====================================================================
    classDef trigger fill:#0f172a,stroke:#38bdf8,color:#fff,stroke-width:2px
    classDef stage fill:#0f766e,stroke:#5eead4,color:#fff
    classDef gate fill:#7c2d12,stroke:#fbbf24,color:#fff,stroke-width:2px
    classDef write fill:#312e81,stroke:#a5b4fc,color:#fff
    classDef skip fill:#1f2937,stroke:#f87171,color:#fff,stroke-dasharray: 5 5
    classDef ai fill:#581c87,stroke:#d8b4fe,color:#fff
    classDef done fill:#15803d,stroke:#86efac,color:#fff,stroke-width:2px
    classDef db fill:#b45309,stroke:#fcd34d,color:#fff,stroke-width:2px
    classDef bg fill:#374151,stroke:#9ca3af,color:#fff

    class CRON trigger
    class RS,FETCH,SNAP,IND,DET,ENRICH,MERGE stage
    class G1,G2 gate
    class W0,W1 write
    class SKIP1,SKIP2,DROP,DETFAIL,FALL skip
    class CLEAN,EXTRACT,RESP ai
    class SAVE done
    class FS_COMP,FS_JOBS,FS_RUNS,FS_RT db
    class BW1,BW2,BW3 bg
