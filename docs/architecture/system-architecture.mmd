%% Glowminds AI Career Platform — System Architecture + API Surface
%% Render with:
%%   npx -y -p @mermaid-js/mermaid-cli mmdc -i system-architecture.mmd \
%%     -o system-architecture.png -w 3600 -H 2600 -b transparent
flowchart LR

    %% ====================================================================
    %% USERS
    %% ====================================================================
    USER(["👤 <b>End user</b><br/>browser"])

    %% ====================================================================
    %% CLIENT (Firebase Hosting)
    %% ====================================================================
    subgraph client ["🌐 React SPA — Vite build on Firebase Hosting"]
        direction TB

        subgraph clientShell ["App shell"]
            ROUTER["⚛️ React Router<br/>/, /dashboard/*"]
            AUTHHK["🔐 useAuthListener<br/>onAuthStateChanged<br/>loads user profile"]
            API["📡 apiClient<br/>fetch + ID token header<br/>401 → auto logout"]
        end

        subgraph clientStores ["Zustand stores (in-memory + Firestore-backed)"]
            direction LR
            S_AUTH["authStore"]
            S_PROFILE["profileStore<br/>(users/{uid})"]
            S_TRACK["trackerStore<br/>(applications)"]
            S_JOB["jobStore<br/>(saved + search cache)"]
            S_AI["aiChatStore<br/>(aiChats)"]
            S_INT["interviewStore<br/>(interviewSessions)"]
            S_NOTIF["notifStore<br/>(onSnapshot)"]
        end

        subgraph clientSections ["Dashboard sections"]
            direction TB
            SEC_OV["📊 Overview"]
            SEC_RES["📄 Resume Builder"]
            SEC_JOBS["💼 Job Board"]
            SEC_APP["📋 Applications"]
            SEC_INT["📚 Interview Prep<br/>(MCQ)"]
            SEC_AI["🧭 AI Coach<br/>(streaming chat)"]
            SEC_COV["✉️ Cover Letters"]
            SEC_LIN["🔗 LinkedIn Optimizer"]
            SEC_GR["✍️ Grammar / Paraphrase"]
            SEC_PROF["👤 Profile / Settings"]
        end
    end

    %% ====================================================================
    %% AUTH
    %% ====================================================================
    FBAUTH[("🔥 <b>Firebase Auth</b><br/>Google / Email-password")]

    %% ====================================================================
    %% HETZNER VPS — single host runs Express API + Python enrich + workers
    %% ====================================================================
    subgraph hetzner ["🖥️ Hetzner VPS — single host (Node + Python + cron)"]
        direction TB

        subgraph expressApi ["🟢 Node.js Express API · :3001/api"]
            direction TB

            MWAUTH["🔐 requireAuth<br/>verify Firebase ID token<br/>→ req.user.uid"]
            MWERR["⚠️ errorHandler<br/>sanitized JSON errors"]

            subgraph aiRoutes ["/api/ai/* (all behind requireAuth)"]
                R_CHAT["POST /career-chat"]
                R_IQ["POST /interview-questions"]
                R_EV["POST /evaluate-session"]
                R_JM["POST /job-match"]
                R_PR["POST /profile-review"]
                R_CL["POST /cover-letter"]
                R_GR["POST /grammar"]
                R_PP["POST /paraphrase"]
                R_RP["POST /parse-resume"]
            end

            subgraph jobsRoutes ["/api/jobs/*"]
                R_SEARCH["POST /search<br/>profile-aware query + scoring"]
            end

            subgraph usageRoutes ["/api/usage/*"]
                R_TRACK["POST /track<br/>(allowlist of UI-only tools)"]
            end

            subgraph payRoutes ["/api/payments/razorpay"]
                R_ORDER["POST /create-order"]
                R_VERIFY["POST /verify"]
            end

            R_HEALTH["GET /api/health"]
        end

        subgraph aiClient ["🧠 aiClient.js — per-task model routing"]
            direction LR
            TASK_REG["task registry<br/>primary + fallback<br/>temp · maxTokens · json"]
            GEM["geminiGenerate<br/>flash · flash-lite<br/>thinkingBudget: 0"]
            OR["openrouterGenerate<br/>free-tier models<br/>retry chain"]
            TRACK["trackAsync<br/>fire-and-forget"]
        end

        subgraph pyService ["🐍 Python enrich · Flask :5000 (localhost-only)"]
            PY_H["GET /health"]
            PY_E["POST /enrich<br/>BeautifulSoup + regex NLP<br/>→ skills/experience/role/seniority/remote"]
        end

        subgraph syncPipeline ["🛰️ ATS sync pipeline (in-process)"]
            direction TB
            SYNC_RUN["runAllProviders / runProvider<br/>(per-platform concurrency)"]
            SYNC_ONE["syncCompany<br/>listing → gate → India filter<br/>→ detail → enrich → save"]
        end

        subgraph bgWorkers ["⏰ node-cron workers (same process)"]
            direction LR
            BW_EXP["Expiration · daily 02:00<br/>lastSeenAt < now-14d → EXPIRED"]
            BW_RT["Retry queue · every 15m"]
            BW_HE["Health check · every 1h<br/>syncFailures > N → inactive"]
        end
    end

    %% ====================================================================
    %% EXTERNAL APIs
    %% ====================================================================
    subgraph externals ["🌍 External services"]
        direction TB
        GEMINI[("✨ <b>Google Gemini</b><br/>gemini-2.5-flash<br/>gemini-2.5-flash-lite")]
        OPENR[("🔀 <b>OpenRouter</b><br/>free-tier fallback models")]
        RZP[("💳 <b>Razorpay</b><br/>orders + signature verify")]
    end

    %% ====================================================================
    %% ATS SOURCES (read-only ingestion sources)
    %% ====================================================================
    subgraph atsSources ["🏷️ ATS providers (public job feeds)"]
        direction LR
        GH["Greenhouse"]
        LV["Lever"]
        ASH["Ashby"]
        BB["BambooHR"]
        WD["Workday"]
    end

    %% ====================================================================
    %% FIRESTORE — single source of truth
    %% ====================================================================
    subgraph firestore ["🔥 Cloud Firestore"]
        direction TB

        subgraph fsServer ["Server-owned (Admin SDK only)"]
            FS_COMP[("companies/{slug}")]
            FS_JOBS[("jobs/{jobId}<br/>status · indexedAt · searchText")]
            FS_RUNS[("sync_runs/{id}")]
            FS_RT[("retry_queue/{id}")]
            FS_FAIL[("failed_jobs/{id}")]
        end

        subgraph fsUser ["User-owned (rules: owner-read/write)"]
            FS_USERS[("users/{uid}<br/>profile · flags<br/>settings · subscription · usage")]
            FS_APPS[("users/{uid}/applications")]
            FS_SAVED[("users/{uid}/savedJobs")]
            FS_CHATS[("users/{uid}/aiChats")]
            FS_SESS[("users/{uid}/interviewSessions")]
            FS_RESUME[("users/{uid}/resumes/{id}")]
            FS_NOTIF[("users/{uid}/notifications")]
        end
    end

    %% ====================================================================
    %% ===== CLIENT FLOWS =====
    %% ====================================================================
    USER --> ROUTER
    ROUTER --> clientSections

    %% Auth handshake
    AUTHHK <-->|"sign-in · ID token"| FBAUTH
    AUTHHK --> S_AUTH
    AUTHHK -->|"profileStore.load (once)"| FS_USERS

    %% Section → store wiring (logical, not exhaustive)
    SEC_OV --- S_PROFILE & S_TRACK & S_JOB
    SEC_JOBS --- S_JOB
    SEC_APP --- S_TRACK
    SEC_AI --- S_AI
    SEC_INT --- S_INT
    SEC_PROF --- S_PROFILE

    %% Direct Firestore I/O for owner-scoped data (no backend hop)
    S_PROFILE <-->|"get/set users/{uid}"| FS_USERS
    S_TRACK <-->|"applications CRUD"| FS_APPS
    S_JOB <-->|"savedJobs CRUD"| FS_SAVED
    S_AI <-->|"aiChats CRUD"| FS_CHATS
    S_INT <-->|"interviewSessions CRUD"| FS_SESS
    S_NOTIF <-->|"onSnapshot · limit 50"| FS_NOTIF

    %% Backend-bound traffic
    clientSections -->|"fetch + Bearer ID token"| API
    API -->|"HTTPS /api/*"| expressApi

    %% ====================================================================
    %% ===== BACKEND ROUTING =====
    %% ====================================================================
    expressApi --> MWAUTH
    MWAUTH --> aiRoutes
    MWAUTH --> jobsRoutes
    MWAUTH --> usageRoutes
    MWAUTH --> payRoutes
    expressApi --> R_HEALTH

    %% AI fan-out
    aiRoutes -->|"chatTask / completionTask"| aiClient
    TASK_REG --> GEM
    TASK_REG --> OR
    GEM -->|"X-goog-api-key"| GEMINI
    OR -->|"Bearer OPENROUTER_API_KEY"| OPENR
    aiClient --> TRACK -->|"FieldValue.increment<br/>users/{uid}.usage"| FS_USERS

    %% Jobs search reads jobs + profile context
    R_SEARCH -->|".where(status=ACTIVE)<br/>.where(searchText ARRAY_CONTAINS)"| FS_JOBS
    R_SEARCH -->|"loadProfileContext"| FS_USERS

    %% Usage
    R_TRACK --> TRACK

    %% Payments
    R_ORDER --> RZP
    R_VERIFY -->|"HMAC verify<br/>→ subscription update"| FS_USERS

    %% ====================================================================
    %% ===== SYNC + ENRICH PIPELINE =====
    %% ====================================================================
    SYNC_RUN --> SYNC_ONE
    SYNC_ONE -->|"listing fetch"| GH & LV & ASH & BB & WD
    SYNC_ONE -->|"detail fetch (new/changed)"| GH & LV & ASH & BB & WD
    SYNC_ONE -->|"POST /enrich (HTTP localhost)"| PY_E
    SYNC_ONE -->|"upsert jobs · update company counters"| FS_JOBS
    SYNC_ONE --> FS_COMP
    SYNC_RUN -->|"sync_runs/{id}"| FS_RUNS
    SYNC_ONE -.->|"errors"| FS_RT

    %% Background workers
    BW_EXP -->|"jobs.where(lastSeenAt < cutoff)<br/>→ status = EXPIRED"| FS_JOBS
    BW_RT --> FS_RT
    BW_RT --> syncPipeline
    BW_HE -->|"flip active=false"| FS_COMP

    %% ====================================================================
    %% ===== STYLES =====
    %% ====================================================================
    classDef user fill:#0c4a6e,stroke:#7dd3fc,color:#fff,stroke-width:2px
    classDef client fill:#0f766e,stroke:#5eead4,color:#fff
    classDef store fill:#1e3a8a,stroke:#93c5fd,color:#fff
    classDef section fill:#312e81,stroke:#a5b4fc,color:#fff
    classDef mw fill:#7c2d12,stroke:#fbbf24,color:#fff,stroke-width:2px
    classDef route fill:#0f172a,stroke:#38bdf8,color:#fff
    classDef ai fill:#581c87,stroke:#d8b4fe,color:#fff
    classDef py fill:#155e75,stroke:#67e8f9,color:#fff
    classDef sync fill:#3f6212,stroke:#bef264,color:#fff
    classDef bg fill:#374151,stroke:#9ca3af,color:#fff
    classDef ext fill:#9f1239,stroke:#fda4af,color:#fff
    classDef db fill:#b45309,stroke:#fcd34d,color:#fff,stroke-width:2px
    classDef ats fill:#831843,stroke:#fbcfe8,color:#fff
    classDef auth fill:#7e22ce,stroke:#e9d5ff,color:#fff,stroke-width:2px

    class USER user
    class ROUTER,AUTHHK,API client
    class S_AUTH,S_PROFILE,S_TRACK,S_JOB,S_AI,S_INT,S_NOTIF store
    class SEC_OV,SEC_RES,SEC_JOBS,SEC_APP,SEC_INT,SEC_AI,SEC_COV,SEC_LIN,SEC_GR,SEC_PROF section
    class MWAUTH,MWERR mw
    class R_CHAT,R_IQ,R_EV,R_JM,R_PR,R_CL,R_GR,R_PP,R_RP,R_SEARCH,R_TRACK,R_ORDER,R_VERIFY,R_HEALTH route
    class TASK_REG,GEM,OR,TRACK ai
    class PY_H,PY_E py
    class SYNC_RUN,SYNC_ONE sync
    class BW_EXP,BW_RT,BW_HE bg
    class GEMINI,OPENR,RZP ext
    class FS_COMP,FS_JOBS,FS_RUNS,FS_RT,FS_FAIL,FS_USERS,FS_APPS,FS_SAVED,FS_CHATS,FS_SESS,FS_RESUME,FS_NOTIF db
    class GH,LV,ASH,BB,WD ats
    class FBAUTH auth
