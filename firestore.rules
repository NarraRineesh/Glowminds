rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----- helpers -----
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function protectedUserFieldsUnchanged() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return !affected.hasAny(['subscription', 'credits', 'billing', 'entitlements']);
    }

    // Free-tier subscription shape allowed on client create (signup / Google login).
    function isFreeSubscriptionOnCreate(sub) {
      return sub.plan == 'free'
        && sub.get('tier', null) == null
        && sub.get('status', null) != 'active'
        && sub.get('razorpayPaymentId', null) == null
        && sub.get('razorpayOrderId', null) == null
        && !sub.keys().hasAny(['source', 'grantedBy', 'revokedBy']);
    }

    function userCreateAllowed() {
      return isOwner(userId)
        && !request.resource.data.keys().hasAny(['credits', 'billing', 'entitlements'])
        && (
          !request.resource.data.keys().hasAny(['subscription'])
          || isFreeSubscriptionOnCreate(request.resource.data.subscription)
        );
    }

    // ----- users root doc -----
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if userCreateAllowed();
      allow update: if isOwner(userId) && protectedUserFieldsUnchanged();
      allow delete: if isOwner(userId);
    }

    // Application creates are server-authoritative (POST /api/applications).
    match /users/{userId}/applications/{appId} {
      allow read, update, delete: if isOwner(userId);
      allow create: if false;
    }

    // Credit ledger is append-only via Admin SDK.
    match /users/{userId}/creditLedger/{entryId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Other user subcollections (resumes, savedJobs, notifications, …).
    match /users/{userId}/{subcollection}/{docId} {
      allow read, write: if isOwner(userId)
        && subcollection != 'applications'
        && subcollection != 'creditLedger';
    }

    match /users/{userId}/{subcollection}/{docId}/{rest=**} {
      allow read, write: if isOwner(userId)
        && subcollection != 'applications'
        && subcollection != 'creditLedger';
    }

    // ----- jobs (curated, optional) -----
    match /jobs/{jobId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Per-user tool usage counters live on `users/{uid}.usage` and are
    // covered by the existing users rule (owner-read, owner-write).

    // ----- contact form (unauthenticated create, no read) -----
    match /contactMessages/{msgId} {
      allow create: if request.resource.data.keys().hasOnly(['name','email','mobile','subject','message','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.mobile is string
        && request.resource.data.mobile.size() <= 20
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 8000
        && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if false;
    }
  }
}
