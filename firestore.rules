rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----- helpers -----
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    // ----- users root doc -----
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // ----- all user subcollections (resumes, applications, savedJobs,
    // notifications, aiChats, interviewSessions, chat (legacy), ...).
    // Note: cover letters, JD matches, and daily quiz answers are NOT
    // persisted server-side; only gamification fields on the user doc are
    // written (quiz → XP; login → streak). -----
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // ----- jobs (curated, optional) -----
    match /jobs/{jobId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ----- badges catalog (public read, admin write) -----
    match /badges/{badgeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Per-user tool usage counters live on `users/{uid}.usage` and are
    // covered by the existing users rule (owner-read, owner-write).
    // Admin-wide aggregation is exposed via the backend endpoint
    // `GET /api/usage/aggregate` (requires the `admin` custom claim).

    // ----- contact form (unauthenticated create, no read) -----
    match /contactMessages/{msgId} {
      allow create: if request.resource.data.keys().hasOnly(['name','email','mobile','subject','message','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.mobile is string
        && request.resource.data.mobile.size() <= 20
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 8000
        && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if false;
    }
  }
}
