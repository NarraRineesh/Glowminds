rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----- helpers -----
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isOwnerByUserId() {
      return request.auth != null && request.auth.uid == resource.data.userId;
    }

    function isOwnerByUserIdOnCreate() {
      return request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    function protectedUserFieldsUnchanged() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return !affected.hasAny(['subscription', 'credits', 'billing', 'entitlements', 'usage']);
    }

    function userCreateAllowed(userId) {
      return isOwner(userId)
        && !request.resource.data.keys().hasAny([
          'subscription',
          'credits',
          'billing',
          'entitlements',
          'usage',
        ]);
    }

    // ----- users root doc (identity, profile, settings only) -----
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if userCreateAllowed(userId);
      allow update: if isOwner(userId) && protectedUserFieldsUnchanged();
      allow delete: if isOwner(userId);

      // [v2:activity] Dashboard / analytics event log
      match /activity/{eventId} {
        allow read, create: if isOwner(userId);
        allow update, delete: if isOwner(userId);
      }

      // [v2:vault] Career Vault document metadata
      match /vault/{docId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    // ----- top-level user-owned collections -----
    match /applications/{appId} {
      allow read, update, delete: if isOwnerByUserId();
      allow create: if false;
    }

    match /savedJobs/{docId} {
      allow read, update, delete: if isOwnerByUserId();
      allow create: if isOwnerByUserIdOnCreate();
    }

    match /resumes/{docId} {
      allow read, update, delete: if isOwnerByUserId();
      allow create: if isOwnerByUserIdOnCreate();
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if isOwnerByUserId();
      allow create: if isOwnerByUserIdOnCreate();
    }

    match /aiChats/{chatId} {
      allow read, update, delete: if isOwnerByUserId();
      allow create: if isOwnerByUserIdOnCreate();
    }

    match /interviewSessions/{sessionId} {
      allow read, update, delete: if isOwnerByUserId();
      allow create: if isOwnerByUserIdOnCreate();
    }

    // Server-authoritative checkout intents (Razorpay orders)
    match /checkoutSessions/{orderId} {
      allow read, write: if false;
    }

    // Server-authoritative billing & credits
    match /subscriptions/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /subscriptions/{userId}/payments/{paymentId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /userCredits/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /userEntitlements/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /creditLedger/{entryId} {
      allow read: if isOwnerByUserId();
      allow write: if false;
    }

    // ----- jobs (curated, optional) -----
    match /jobs/{jobId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ----- contact form (unauthenticated create, no read) -----
    match /contactMessages/{msgId} {
      allow create: if request.resource.data.keys().hasOnly(['name','email','mobile','subject','message','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.mobile is string
        && request.resource.data.mobile.size() <= 20
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 8000
        && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if false;
    }

    // Admin / server-only telemetry (Admin SDK bypasses rules)
    match /aiUsageLogs/{logId} {
      allow read, write: if false;
    }

    match /adminDailyStats/{dayId} {
      allow read, write: if false;
    }
  }
}
