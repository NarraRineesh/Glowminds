# Non-secret config deployed with the function via Firebase CLI.
# Copy to functions/.env for local emulator runs.
#
# Secrets (GEMINI_API_KEY, OPENROUTER_API_KEY, RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET)
# must be set via:
#   firebase functions:secrets:set GEMINI_API_KEY
#   firebase functions:secrets:set OPENROUTER_API_KEY
#   firebase functions:secrets:set RAZORPAY_KEY_ID
#   firebase functions:secrets:set RAZORPAY_KEY_SECRET

NODE_ENV=production
CORS_ORIGINS=https://glowminds-abc84.web.app,https://glowminds-abc84.firebaseapp.com,https://glowminds.in,http://localhost:5173,http://localhost:4173,http://127.0.0.1:5000

OPENROUTER_SITE_URL=https://ai-jobcopilot.web.app
OPENROUTER_APP_NAME=Glowminds AI Job Copilot
