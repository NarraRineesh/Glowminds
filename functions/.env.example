# Non-secret config deployed with the function via Firebase CLI.
# Copy to functions/.env for local emulator runs.
#
# Secrets (GEMINI_API_KEY, OPENROUTER_API_KEY, RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET)
# must be set via:
#   firebase functions:secrets:set GEMINI_API_KEY
#   firebase functions:secrets:set OPENROUTER_API_KEY
#   firebase functions:secrets:set RAZORPAY_KEY_ID
#   firebase functions:secrets:set RAZORPAY_KEY_SECRET
#
# Local emulator: put the same secret names in functions/.secret.local
# (KEY=value per line). Without RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET,
# create-order returns 503 unavailable.

NODE_ENV=production
CORS_ORIGINS=https://glowminds-abc84.web.app,https://glowminds-abc84.firebaseapp.com,https://glowminds.in,https://www.glowminds.in,https://app.glowminds.in,https://glowminds-app.web.app,http://localhost:5173,http://localhost:4173,http://127.0.0.1:5000

OPENROUTER_SITE_URL=https://ai-jobcopilot.web.app
OPENROUTER_APP_NAME=Glowminds AI Job Copilot

# Optional: AES-256-GCM key for pricing config (64 hex chars = 32 bytes).
# When set, Firestore config/pricing is stored encrypted and GET /api/config/pricing
# returns an encrypted payload. Set the same value as VITE_PRICING_ENCRYPTION_KEY
# in the frontend .env so the app can decrypt pricing in the browser.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PRICING_ENCRYPTION_KEY=
