{
  "name": "glowminds",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "concurrently -n web,fn -c blue,green --kill-others-on-fail \"pnpm:dev:web\" \"pnpm:dev:fn\"",
    "dev:web": "vite",
    "dev:clean": "rm -rf node_modules/.vite && pnpm dev:web",
    "dev:full": "concurrently -n web,fn -c blue,green \"pnpm:dev:web\" \"pnpm:dev:fn\"",
    "dev:fn": "firebase emulators:start --only functions",
    "dev:fn:full": "firebase emulators:start --only functions,firestore",
    "build": "pnpm --filter glowminds-resume compile && vite build && node scripts/prerender-seo.mjs",
    "seo:ping": "node scripts/ping-indexnow.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "pnpm build && firebase deploy --only functions,hosting,firestore && node scripts/ping-indexnow.mjs",
    "admin:set": "node scripts/set-admin.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.12.1",
    "framer-motion": "^12.38.0",
    "glowminds-resume": "workspace:*",
    "html2canvas-pro": "^2.0.2",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.14.1",
    "recharts": "^3.9.2",
    "sass": "^1.101.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@lingui/vite-plugin": "^6.1.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/router-plugin": "^1.168.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.9"
  }
}
