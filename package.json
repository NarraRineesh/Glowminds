{
  "name": "ai-job-copilot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,fn -c blue,green --kill-others-on-fail \"npm:dev:web\" \"npm:dev:fn\"",
    "dev:web": "vite",
    "dev:clean": "rm -rf node_modules/.vite && npm run dev:web",
    "dev:full": "concurrently -n web,fn -c blue,green \"npm:dev:web\" \"npm:dev:fn\"",
    "dev:fn": "firebase emulators:start --only functions",
    "dev:fn:full": "firebase emulators:start --only functions,firestore",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy --only functions,hosting,firestore"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.3",
    "firebase": "^12.12.1",
    "framer-motion": "^12.38.0",
    "html2canvas-pro": "^2.0.2",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.14.1",
    "tailwindcss": "^4.2.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.9"
  }
}
