rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function underSizeLimit() {
      return request.resource == null || request.resource.size < 5 * 1024 * 1024;
    }

    // Canonical vault path: {uid}/vault/...
    match /{userId}/vault/{allPaths=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && underSizeLimit();
    }

    // Legacy path (pre-migration): vault/{uid}/...
    match /vault/{userId}/{allPaths=**} {
      allow read, delete: if isOwner(userId);
      allow write: if isOwner(userId) && underSizeLimit();
    }
  }
}
